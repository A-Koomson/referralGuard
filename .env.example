# ReferralGuard — environment template (placeholder names only; never commit real secrets)

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Demo bootstrap (required for noninteractive seed)
BOOTSTRAP_SUPERADMIN_EMAIL=admin@referralguard.local
BOOTSTRAP_SUPERADMIN_PASSWORD=
BOOTSTRAP_ALLOW_GENERATED_PASSWORD=True
BOOTSTRAP_ALLOW_PRODUCTION=False

# LLM provider (live mode only — never silently fall back to mock on failure)
# Groq example: LLM_BASE_URL=https://api.groq.com/openai/v1
# Recommended Groq models (Aug 2026): openai/gpt-oss-120b or qwen/qwen3.6-27b
# llama-3.3-70b-versatile was retired on Groq developer tier — do not use
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Optional cost reporting (leave empty for "not measured")
LLM_PRICE_INPUT_PER_1M=
LLM_PRICE_OUTPUT_PER_1M=
